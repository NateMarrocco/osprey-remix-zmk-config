#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/* ================================
 * LAYER TAP CONFIG
 * HOLD = layer
 * TAP = key
 * VERY FAST BUT USABLE
 * ================================ */
&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <180>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
};

/ {
    combos {
        compatible = "zmk,combos";

        print_screen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <25 26 27>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 19>;
        };

        minus2 {
            bindings = <&kp MINUS>;
            key-positions = <17 16>;
        };
    };

    behaviors {
        control_alt_macro: control_alt_macro {
            compatible = "zmk,behavior-macro";
            label = "CONTROL_ALT";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LALT>;
        };

        alt_tab_macro: alt_tab_macro {
            compatible = "zmk,behavior-macro";
            label = "ALT_TAB_MACRO";
            #binding-cells = <0>;
            bindings = <&kp LA(TAB)>;
        };

        shift_space_to_enter: shift_space_to_enter {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_SPACE_TO_ENTER";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp ENTER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        toggle_mouse_layer: toggle_mouse_layer {
            compatible = "zmk,behavior-macro";
            label = "TOGGLE_MOUSE_LAYER";
            #binding-cells = <0>;
            bindings = <&kp F11>, <&tog 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Base";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp D  &kp F   &kp G   &kp Y  &kp J  &kp K   &kp L  &kp P   &kp BACKSPACE
&kp GRAVE  &kp A  &kp S  &kp E  &kp R   &kp T   &kp H  &kp U  &kp I   &kp O  &kp N   &kp ESCAPE
&kp LC(C)  &kp Z  &kp X  &kp C  &kp V   &kp B        &kp COLON &kp M &kp COMMA &kp DOT &kp ENTER &kp LC(V)
                &lt 2 F8   &kp LSHIFT   &lt 1 F7   &kp F15   &kp SPACE   &mo 4
            >;
        };

        lower_layer {
            label = "Lower";
            bindings = <
&kp GRAVE &kp LC(N1) &kp LC(Z) &kp LBRC &kp AT &kp PRCNT &kp DOUBLE_QUOTES &kp LWIN &kp COMMA &kp LC(Z) &kp EXCLAMATION &kp LC(W)
&kp SEMI  &kp F1 &kp F2 &kp F3 &kp F4 &kp LC(N6) &kp LC(N7) &kp  LC(N1) &kp LC(N2) &kp LC(N3) &kp LC(N4) &kp LC(N5)
&trans &kp LS(F1) &kp LS(F2) &kp LS(F3) &kp LS(F4) &kp S &kp S &kp EXCLAMATION &kp DOLLAR &kp AT &kp FSLH &kp SINGLE_QUOTE
                    &trans &trans &kp F1 &kp UNDER &kp LA(TAB) &kp QMARK
            >;
        };

        raise_layer {
            label = "Raise";
            bindings = <
&kp ESCAPE &kp S &kp AT &kp LBRC &kp LC(Z) &kp EQUAL &kp CARET &kp ASTRK &kp PLUS &kp MINUS &kp TILDE &kp BACKSPACE
&kp LESS_THAN &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp GREATER_THAN
 &tog 3 &kp LEFT_ARROW &kp RIGHT_ARROW &kp UP_ARROW &kp DOWN_ARROW &kp DOLLAR &kp HASH &kp QMARK &kp EXCLAMATION &kp COMMA &kp FSLH &trans
                  &trans   &trans &kp UNDER &trans &trans &trans
            >;
        };

        adjust_layer {
            label = "Adjust";
            bindings = <
&kp ESCAPE   &kp Q  &kp W  &kp D  &kp F   &kp G   &kp Y  &kp J  &kp K   &kp L  &kp P   &kp BACKSPACE
&kp ENTER  &kp A  &kp S  &kp E  &kp R   &kp T   &kp H  &kp U  &kp I   &kp O  &kp N   &kp ESCAPE
&tog 3 &kp Z  &kp X  &kp C  &kp V   &kp B        &kp COLON &kp M &kp COMMA &kp DOT &kp ENTER &kp LC(V)
                 &kp O  &kp I &kp N &kp M &kp H &trans
            >;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
 &kp ESCAPE &kp BACKSLASH &kp C_MUTE &kp C_VOL_UP &kp C_VOL_DN &kp DOUBLE_QUOTES &kp MINUS &trans &kp AMPS &kp AT &trans &trans
&kp LC(A) &kp SEMI &kp PERCENT &kp LPAR &kp RPAR &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LBRC &kp RBRC &kp EXCLAMATION &kp QMARK &kp HASH
&trans &trans &trans &kp SINGLE_QUOTE &kp LEFT_BRACKET &kp RIGHT_BRACKET &trans &out OUT_BLE &out OUT_TOG &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1
                    &kp LC(V) &kp LWIN &kp LC(C) &trans &trans &kp D
            >;
        };
    };
};
