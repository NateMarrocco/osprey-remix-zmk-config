
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
};

/ {
    combos {
        compatible = "zmk,combos";
        
        print_screen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <25 26 27>;
        };
        
        equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 19>;
        };
        
        minus2 {
            bindings = <&kp MINUS>;
            key-positions = <17 16>;
        };
    };
    
    behaviors {
        control_alt_macro: control_alt_macro {
            compatible = "zmk,behavior-macro";
            label = "CONTROL_ALT";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LALT>;
        };

        
        alt_tab_macro: alt_tab_macro {
            compatible = "zmk,behavior-macro";
            label = "ALT_TAB_MACRO";
            #binding-cells = <0>;
            bindings = <&kp LA(TAB)>;
        };
        
        shift_space_to_enter: shift_space_to_enter {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_SPACE_TO_ENTER";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp ENTER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        
        toggle_mouse_layer: toggle_mouse_layer {
            compatible = "zmk,behavior-macro";
            label = "TOGGLE_MOUSE_LAYER";
            #binding-cells = <0>;
            bindings = <&kp F11>, <&tog 4>;
        };
    };
    
    keymap {
        compatible = "zmk,keymap";
        // TODO add tab key so that u can tab throuh dialhuge
        default_layer {
            label = "Base";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp D  &kp F   &kp G   &kp Y  &kp J  &kp K   &kp L  &kp P   &kp BACKSPACE
&kp GRAVE  &kp A  &kp S  &kp E &kp R  &kp T   &kp H  &kp U  &kp I   &kp O   &kp  N  &kp ESCAPE
&kp LC(SEMI)    &kp Z  &kp X  &kp C  &kp V   &kp B   &kp COMMA &kp M  &kp ESCAPE &kp DOT &kp F15  &kp ENTER
                            &kp LSHIFT  &mo 1 &mo 2        &mo 3  &kp SPACE &kp  LALT
            >;
        };// TODO switching wont work from layres, we need to replace mo 1 with ctrl-alt, then we need to use the komorebi ahk script to 
// catch the ctrl-alt-other keys and map them to what we want
        
        lower_layer {
            label = "Lower";
            bindings = <
&kp GRAVE  &kp LC(N1)  &kp LC(N2)   &kp LBRC  &kp RBRC   &kp PRCNT  &kp CARET       &kp LPAR    &kp RPAR   &kp AMPS     &kp F14            &kp LC(W)
&kp F13     &kp F1    &kp F2   &kp F3    &kp F4   &kp F5     &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)  &kp LA(N5)  &kp LA(N6)
&kp QMARK     &kp LS(F1)    &kp LS(F2) &kp LS(F3)    &kp LS(F4)     &kp LS(F5)     &kp LS(F6)         &kp LS(F7)    &kp LS(F8)     &kp LS(F9)            &kp FSLH          &trans
                              &trans    &trans     &mo 3      &kp MINUS        &kp  LA(LS(TAB))    &kp LSHIFT
            >;
        };
        
        raise_layer {
            label = "Raise";
            bindings = <
&kp ESCAPE  &kp S &kp AT  &kp LBRC       &kp RBRC    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR &kp GRAVE  &kp BACKSPACE
&kp Q        &kp N1  &kp N2        &kp N3          &kp N4      &kp N5  &kp N6  &kp N7  &kp N8  &kp N9 &kp N0 &kp SEMI
&trans      &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp DLLR      &kp HASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp COMMA &kp FSLH  &trans
                            &trans        &trans          &kp UNDER   &kp EXCL   &kp QMARK  &trans
            >;
        };
        
        adjust_layer {
            label = "Adjust";
            bindings = <
&none   &none   &none   &kp C_VOL_UP    &kp LC(R)  &none    &bt BT_SEL 0  &kp C_VOL_UP      &kp C_VOL_DN   &kp C_MUTE  &trans  &bt BT_CLR
&kp PRCNT  &kp LC(A)  &kp   LC(Z) &kp LC(F)   &kp   LC(C)     &kp  PLUS &kp  MINUS    &kp LC(V)    &kp UNDER     &kp EQUAL   &kp COLON   &none
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11      &kp F12  &none         &sys_reset  &none         &none   &none   &none
                        &trans   &trans       &trans   &trans        &trans      &trans
            >;
        };
        
        mouse_layer {
            label = "Mouse";
            bindings = <
&trans     &trans      &trans     &kp E        &trans     &trans     &trans     &trans     &kp I      &trans     &trans    &trans
&trans     &kp F22     &kp F21    &kp Z       &kp Z     &kp Z     &kp Z     &kp J      &kp K      &kp L      &kp Z  &trans 
&trans     &trans      &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans     &trans    &trans
                                  &trans       &trans     &trans     &trans     &trans     &kp D
            >;
        };
    };
};
